# ============================================================
# 环境变量示例 — 复制为 .env 后填入实际值
# 所有框架环境变量以 TF_ 为前缀
# ============================================================

# ---------- 框架基础配置 ----------
TF_ENV=dev
TF_DEBUG=false
TF_LOG_LEVEL=INFO

# ---------- 输出目录 ----------
TF_REPORTS_DIR=reports
TF_RESULTS_DIR=results
TF_LOGS_DIR=logs

# ---------- 被测系统 A ----------
SYSTEM_A_BASE_URL=http://localhost:8080
SYSTEM_A_TOKEN=your_token_here

# ---------- 被测系统 B ----------
SYSTEM_B_BASE_URL=http://localhost:9090
SYSTEM_B_TOKEN=your_token_here

# ---------- 数据库连接 ----------
POSTGRES_DSN=postgresql://user:pass@localhost:5432/testdb
MYSQL_DSN=mysql://user:pass@localhost:3306/testdb
MONGODB_URI=mongodb://localhost:27017/testdb
REDIS_URL=redis://localhost:6379/0

# ---------- 外部集成 ----------
SLACK_WEBHOOK_URL=
GRAFANA_URL=
PROMETHEUS_GATEWAY=http://localhost:9091
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 本文件：环境变量示例（复制为「config/.env」后本地使用；勿将含机密的 .env 提交 Git）。
# 键名与代码读取处逐键核对由 test_cases/paper_interpret/test_env_doc_contract_offline.py 常驻守护。

# 环境标识（dev/test/pre/prod），切换环境只需修改此项
# 未配置时使用 config/environments.yaml 中的 default_env（默认 prod）
TEST_ENV=pre

# 应用网关基础地址（可选，手动覆盖 environments.yaml 中的配置）
# 不配置时自动使用 TEST_ENV 对应环境的 base_url
# BASE_URL=

# 登录态 token，注入 Uniplore-Auth 请求头（浏览器登录后，开发者工具 Network 面板任一 API 请求头中复制 accessToken）
# 已配下面 LOGIN_USERNAME/LOGIN_PASSWORD 时本项可留空：conftest 的 token fixture 会自动登录获取
TOKEN=

# 主账号（自动登录用）：conftest 的 token fixture 用这组凭据登录拿 TOKEN
# 未配置且 TOKEN 也为空时，依赖登录的用例会在 fixture 阶段失败
LOGIN_USERNAME=
LOGIN_PASSWORD=

# 刷新令牌（可选）：配置后自动续期 TOKEN，无需重复拖滑块登录；首次登录成功后由 token_refresher 回写 config/.env
# REFRESH_TOKEN=

# 客户端 Basic 认证，注入 Authorization 头（可选）：未配置时用 core/utils/config.py 内置的默认客户端凭据
# AUTHORIZATION=

# 第二个测试账号（对端账号，仅本地使用、勿写真实密码入库）：跨账号越权用例预留；
# 当前本仓未启用跨账号用例，配置与否不影响现有用例
# LOGIN_USERNAME_B=
# LOGIN_PASSWORD_B=

# 测试论文 PDF 本地路径（paper 论文 AI 用例上传用；素材为 INT-001/002 使用的论文）
PDF_PATH=

# 第二份测试论文 PDF（INT-003 追问上传新文件用例使用，应与第一份领域不同以验证跨文件切换能力）
PDF_PATH_2=

# 知识库 ID（知识库问答类用例必填）：知识库页面 URL 或对话列表接口响应中的 datasetId
DATASET_ID=

# 被测 Agent 使用的 LLM 模型名称（格式：裸模型名，不带渠道前缀，如 qwen3.7-plus；可用清单见服务端接口，渠道由后端解析）
# 未配置时自动从服务端获取第一个可用模型
MODEL_NAME=qwen3.7-plus

# Judge 评审模型服务地址（OpenAI 兼容协议的 LLM 网关，由团队 AI 平台提供）
JUDGE_BASE_URL=

# Judge 评审模型 API Key（团队 AI 平台控制台申请）
JUDGE_API_KEY=

# Judge 评审模型名称（如 kimi-k3，见团队模型清单）——只影响自建 Judge 打分，历史基线绑定此模型，勿随意更换
JUDGE_MODEL=

# Judge 采样温度（可选）：未配置默认 0.1；设为 none 时请求不传该参数
# kimi-k3 等推理模型不支持 temperature（网关返回 HTTP 400 InvalidParameter），此类模型须设为 none
JUDGE_TEMPERATURE=0.1

# Judge 质量门禁开关（默认 false，Judge 平均分低于 3.0 仅警告不影响用例结果）
# 设为 true 时，Judge 平均分低于 3.0 将导致用例失败（硬门禁）
# 注：所有布尔开关只认字面 true（大小写不敏感），配 1/yes 等同关闭
JUDGE_GATE=false

# 测试后是否清理线上数据（默认 false 保留）：保留会话便于事后人工复核产物
CLEANUP_AFTER_TEST=false

# 评估框架开关（默认 false 用自建 Judge 评八维）：true 时四个通用维改走 DeepEval 官方指标、
# 四个业务维仍由自建 Judge 评（路由表见 core/evaluators/dimension_registry.py）；
# ⚠️ 两种模式评分口径不同，历史基线不可跨模式比较；开关切换需重建基线
USE_DEEPEVAL=false

# DeepEval 内置指标的评估模型（可选，仅 USE_DEEPEVAL=true 时生效）：
# 第三方指标要求评估模型严格 JSON 输出，kimi-k3 等思考型模型偶发 invalid JSON；
# 未配置时回退 JUDGE_MODEL。推荐 deepseek 系（JSON 服从性好）；注意网关各模型独立配额
# DEEPEVAL_MODEL=deepseek-v4.1-flash

# Langfuse Trace 可视化平台（Docker 自托管，创建 Project 后获取 Key；host 指向本地容器时需先启动 Docker）
# ⚠️ 本文件会提交 Git，只允许写占位符；真实 Key 写在本地 config/.env（已被 .gitignore 屏蔽）
# ⚠️ 当前 Langfuse SDK 4.x 适配未接通（trace 上报自动禁用），配置仅预留
LANGFUSE_PUBLIC_KEY=pk-lf-<替换为你的PublicKey>
LANGFUSE_SECRET_KEY=sk-lf-<替换为你的SecretKey>
LANGFUSE_HOST=http://localhost:3100

# 黄金评测集严格模式（默认 false）：当前本仓黄金集模块未启用，此开关由 config 读取并预留；
# 启用后 false=文件缺失/未命中仅告警回退内置默认值，true=直接抛错阻断
GOLDEN_STRICT=false
